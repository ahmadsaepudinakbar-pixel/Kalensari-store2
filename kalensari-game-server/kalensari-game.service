[Unit]
Description=Kalensari Game Server (online)
After=network.target

[Service]
Type=simple
User=kalensari
WorkingDirectory=/home/kalensari/kalensari-game-server
ExecStart=NODE_BIN /home/kalensari/kalensari-game-server/server.js
Environment=PORT=8090
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3
MemoryMax=200M

[Install]
WantedBy=multi-user.target
